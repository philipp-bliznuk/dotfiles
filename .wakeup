#!/bin/bash
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# macOS Tahoe has a known bug where the WindowServer renegotiates display
# links on wake from sleep (especially with external monitors over HDMI).
# During this period (~3-8s), ALL rendering is unreliable.
# Sketchybar items that try to render during negotiation end up invisible.
# The only reliable fix is to restart sketchybar AFTER displays stabilize.
#
# We poll for display stability rather than using a fixed sleep.

# Wait until displays are stable (no configuration changes for 2 consecutive seconds)
wait_for_displays() {
    local prev_hash="" curr_hash=""
    local stable_count=0

    for i in $(seq 1 20); do  # max 20 seconds
        curr_hash=$(system_profiler SPDisplaysDataType 2>/dev/null | md5)
        if [[ "$curr_hash" == "$prev_hash" && -n "$curr_hash" ]]; then
            stable_count=$((stable_count + 1))
            [[ $stable_count -ge 2 ]] && return 0
        else
            stable_count=0
        fi
        prev_hash="$curr_hash"
        sleep 1
    done
    return 0  # proceed anyway after timeout
}

wait_for_displays

# Restart sketchybar
pkill -x sketchybar 2>/dev/null
sleep 1
/opt/homebrew/opt/sketchybar/bin/sketchybar &
disown
