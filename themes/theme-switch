#!/bin/zsh
set -euo pipefail

# Resolve dotfiles root from this script's location (themes/ is one level deep)
DOTFILES="${0:A:h:h}"
THEMES_DIR="$DOTFILES/themes"

# --- Formatting ---

reset_color=$(tput sgr 0)

info() { printf "%s[*] %s%s\n" "$(tput setaf 4)" "$1" "$reset_color" }
success() { printf "%s[+] %s%s\n" "$(tput setaf 2)" "$1" "$reset_color" }
err() { printf "%s[!] %s%s\n" "$(tput setaf 1)" "$1" "$reset_color" >&2 }

# --- Name mappings ---

get_yazi_flavor() {
	case "$1" in
	everforest) echo "everforest-medium" ;;
	*) echo "$1" ;;
	esac
}

get_ghostty_theme() {
	case "$1" in
	catppuccin-mocha) echo "Catppuccin Mocha" ;;
	dracula) echo "Dracula" ;;
	nord) echo "Nord" ;;
	rose-pine) echo "Rose Pine" ;;
	tokyo-night) echo "TokyoNight Night" ;;
	gruvbox-dark) echo "Gruvbox Dark" ;;
	kanagawa) echo "Kanagawa Wave" ;;
	everforest) echo "Everforest Dark Hard" ;;
	*) echo "$1" ;;
	esac
}

get_ghostty_cursor_color() {
	case "$1" in
	catppuccin-mocha) echo "#b4befe" ;; # lavender
	dracula) echo "#bd93f9" ;;          # purple
	nord) echo "#88c0d0" ;;             # frost
	rose-pine) echo "#c4a7e7" ;;        # iris
	tokyo-night) echo "#7aa2f7" ;;      # blue
	gruvbox-dark) echo "#fe8019" ;;     # orange
	everforest) echo "#a7c080" ;;       # green
	kanagawa) echo "#7e9cd8" ;;         # wave blue
	*) echo "#b4befe" ;;
	esac
}

# --- Core functions ---

scan_themes() {
	local -a themes=()
	for dir in "$THEMES_DIR"/*/; do
		[[ -f "$dir/theme.zsh" ]] && themes+=("${dir:t}")
	done
	# Sort alphabetically
	print -l "${(o)themes[@]}"
}

get_current_theme() {
	sed -n 's/^export THEME="\(.*\)"/\1/p' "$DOTFILES/.zshenv"
}

show_menu() {
	local current="$(get_current_theme)"

	local selected
	selected=$(scan_themes | fzf \
		--prompt="theme> " \
		--header="current: $current" \
		--no-info \
		--reverse \
		--no-scrollbar) || return 1

	echo "$selected"
}

validate_theme() {
	local target="$1"
	local -a themes=("${(@f)$(scan_themes)}")

	if (( ! ${themes[(I)$target]} )); then
		err "Unknown theme: $target"
		echo ""
		err "Available themes:"
		for t in "${themes[@]}"; do
			printf "    %s\n" "$t" >&2
		done
		return 1
	fi
}

apply_theme() {
	local theme="$1"

	info "Applying theme: $theme..."

	# 1. Update .zshenv
	sed -i '' "s/^export THEME=\".*\"/export THEME=\"$theme\"/" "$DOTFILES/.zshenv"

	# 2. Update ghostty config
	local ghostty_theme="$(get_ghostty_theme "$theme")"
	local ghostty_cursor="$(get_ghostty_cursor_color "$theme")"
	sed -i '' "s/^theme = .*/theme = $ghostty_theme/" "$DOTFILES/ghostty/config"
	sed -i '' "s/^cursor-color = .*/cursor-color = $ghostty_cursor/" "$DOTFILES/ghostty/config"

	# 3. Update yazi flavor
	local yazi_flavor="$(get_yazi_flavor "$theme")"
	sed -i '' "s/^dark = \".*\"/dark = \"$yazi_flavor\"/" "$DOTFILES/yazi/theme.toml"

	# 4. Symlink kitty theme
	ln -sf "$THEMES_DIR/$theme/theme.kitty.conf" "$DOTFILES/kitty/current-theme.conf"

	# 5. Symlink alacritty theme
	ln -sf "$THEMES_DIR/$theme/theme.alacritty.toml" "$DOTFILES/alacritty/current-theme.toml"

	# 6. Rebuild bat cache
	bat cache --build >/dev/null 2>&1

	success "Theme applied: $theme"
}

reload_all() {
	info "Reloading..."

	# Restart sketchybar
	brew services restart sketchybar >/dev/null 2>&1 || true

	# Kill tmux server (this also kills the terminal — everything restarts clean)
	if tmux list-sessions >/dev/null 2>&1; then
		info "Killing tmux server..."
		tmux kill-server
	fi
}

# --- Entry point ---

NO_RELOAD=0
theme_arg=""

# Parse flags
for arg in "$@"; do
	case "$arg" in
	--no-reload) NO_RELOAD=1 ;;
	-*) err "Unknown flag: $arg"; exit 1 ;;
	*) theme_arg="$arg" ;;
	esac
done

if [[ -n "$theme_arg" ]]; then
	# Non-interactive: validate and apply
	validate_theme "$theme_arg"

	current="$(get_current_theme)"
	if [[ "$theme_arg" == "$current" ]]; then
		success "Already using: $theme_arg"
		exit 0
	fi

	apply_theme "$theme_arg"
	(( NO_RELOAD )) || reload_all
else
	# Interactive: show menu
	selected="$(show_menu)" || exit 1

	current="$(get_current_theme)"
	if [[ "$selected" == "$current" ]]; then
		success "Already using: $selected"
		exit 0
	fi

	apply_theme "$selected"
	(( NO_RELOAD )) || reload_all
fi
